cmake_minimum_required(VERSION {{ cmake_minimum }})
project({{ project_name }} CXX)

# C++ standard (explicit, no compiler extensions).
set(CMAKE_CXX_STANDARD {{ cpp_standard }})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Export compile_commands.json for clangd and `llmtk context export`.
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
{% if pic %}
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
{% endif %}

# Library target. Public headers live under include/.
add_library({{ project_name }} src/{{ project_name }}.cpp)
target_include_directories({{ project_name }} PUBLIC include)

# Warnings kept explicit so they are easy to inspect and override.
target_compile_options({{ project_name }} PRIVATE -Wall -Wextra -Wpedantic)
{% if enable_sanitizers %}

# AddressSanitizer + UBSan in Debug builds.
target_compile_options({{ project_name }} PRIVATE $<$<CONFIG:Debug>:-fsanitize=address,undefined>)
target_link_options({{ project_name }} PRIVATE $<$<CONFIG:Debug>:-fsanitize=address,undefined>)
{% endif %}

# Example program that links the library.
add_executable({{ project_name }}_example examples/{{ project_name }}_example.cpp)
target_link_libraries({{ project_name }}_example PRIVATE {{ project_name }})
{% if enable_tests %}

enable_testing()
add_executable({{ project_name }}_test tests/{{ project_name }}_test.cpp)
target_link_libraries({{ project_name }}_test PRIVATE {{ project_name }})
add_test(NAME {{ project_name }}_test COMMAND {{ project_name }}_test)
{% endif %}
